{
  "name": "narada-dj",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal-native AI DJ research project foundation.",
  "type": "module",
  "bin": {
    "narada": "dist/src/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:native": "node scripts/build-native.mjs",
    "build": "tsc && npm run build:native",
    "test": "npm run build && node --test dist/tests/*/*.test.js",
    "start": "node dist/src/index.js",
    "dev": "npm run build && node dist/src/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.7.0"
  }
}
